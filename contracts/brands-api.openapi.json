{
  "openapi": "3.1.0",
  "info": {
    "title": "Brands API",
    "version": "1.0.0",
    "description": "Owner: main app (S1). GET is public; PATCH needs an editor access token. Consumed by the React BrandList."
  },
  "x-owner": "main app (S1)",
  "paths": {
    "/api/brands/": {
      "get": {
        "summary": "List brands",
        "parameters": [
          { "name": "industry", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Industry slug. Repeat to match any of several; blank is ignored." },
          { "name": "ordering", "in": "query", "required": false, "schema": { "type": "string", "default": "name", "enum": ["name", "-name", "avg_rating", "-avg_rating", "review_count", "-review_count"] }, "description": "Unknown values fall back to name. Brands without reviews sort last in both directions." },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "default": 1 }, "description": "A page past the end is a 404." },
          { "name": "page_size", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } }
        ],
        "responses": {
          "200": { "description": "One page of brands.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BrandPage" } } } },
          "404": { "description": "Page out of range.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/brands/{slug}/": {
      "get": {
        "summary": "One brand",
        "responses": {
          "200": { "description": "The brand.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Brand" } } } },
          "404": { "description": "No such brand.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "patch": {
        "summary": "Edit short_description (editor only; no other field is writable)",
        "security": [{ "bearer": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BrandEdit" } } } },
        "responses": {
          "200": { "description": "The updated brand.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Brand" } } } },
          "400": { "description": "Missing, too long or read-only field.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FieldErrors" } } } },
          "401": { "description": "Missing, invalid or expired token.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "Token is not an editor's.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "No such brand.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "503": { "description": "Signing keys unavailable (auth service down, cold cache).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    }
  },
  "components": {
    "securitySchemes": { "bearer": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } },
    "schemas": {
      "Industry": {
        "type": "object",
        "required": ["name", "slug"],
        "additionalProperties": false,
        "properties": { "name": { "type": "string" }, "slug": { "type": "string" } }
      },
      "TopReview": {
        "type": "object",
        "required": ["title", "slug", "rating", "reviewer", "published_at", "snippet"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "slug": { "type": "string" },
          "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
          "reviewer": { "type": ["string", "null"] },
          "published_at": { "type": "string", "format": "date-time" },
          "snippet": { "type": "string" }
        }
      },
      "Brand": {
        "type": "object",
        "required": ["name", "slug", "industry", "average_rating", "review_count", "short_description", "top_review"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "industry": { "oneOf": [{ "$ref": "#/components/schemas/Industry" }, { "type": "null" }] },
          "average_rating": { "type": ["number", "null"], "minimum": 0, "maximum": 5 },
          "review_count": { "type": "integer", "minimum": 0 },
          "short_description": { "type": "string" },
          "top_review": { "oneOf": [{ "$ref": "#/components/schemas/TopReview" }, { "type": "null" }] }
        }
      },
      "BrandPage": {
        "type": "object",
        "required": ["count", "next", "previous", "results"],
        "additionalProperties": false,
        "properties": {
          "count": { "type": "integer", "minimum": 0, "description": "Brands matching the filter, across all pages." },
          "next": { "type": ["string", "null"], "description": "Absolute URL of the next page, or null." },
          "previous": { "type": ["string", "null"], "description": "Absolute URL of the previous page, or null." },
          "results": { "type": "array", "items": { "$ref": "#/components/schemas/Brand" } }
        }
      },
      "BrandEdit": {
        "type": "object",
        "required": ["short_description"],
        "additionalProperties": false,
        "properties": { "short_description": { "type": "string", "maxLength": 1000, "description": "Stored exactly as sent, blank and whitespace included." } }
      },
      "Error": {
        "type": "object",
        "required": ["detail"],
        "additionalProperties": false,
        "properties": { "detail": { "type": "string" } }
      },
      "FieldErrors": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": { "type": "array", "items": { "type": "string" } },
        "description": "Field name -> messages."
      }
    }
  }
}
